# Copy to .env and adjust. docker-compose and the Quarkus apps read these.

# --- Database ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=feedback
# JDBC URL used by the services (host is "postgres" inside docker-compose, "localhost" when running via mvn)
DB_URL=jdbc:postgresql://localhost:5432/feedback

# --- Mailer (MailHog locally) ---
MAIL_FROM=no-reply@rate-me.local
MAIL_HOST=localhost
MAIL_PORT=1025

# --- Notifications / reports ---
ADMIN_EMAIL=admin@rate-me.local
REPORT_EMAIL=admin@rate-me.local
# Cron for the weekly report job ("off" disables it). Example: 0 0 8 ? * MON
REPORT_CRON=off

# --- auth-service integration ---
AUTH_SERVICE_URL=http://localhost:8085
AUTH_JWKS_URL=http://localhost:8085/.well-known/jwks.json
# MUST match the auth-service JWT_ISSUER value.
JWT_ISSUER=cheffy-auth
