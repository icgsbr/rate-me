# Multi-stage JVM image for report-service.
# Build context is the repository ROOT:
#   docker build -f report-service/src/main/docker/Dockerfile.jvm .

# --- Build stage ---
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY . .
RUN mvn -B -pl report-service -am package -DskipTests

# --- Runtime stage ---
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /build/report-service/target/quarkus-app/ ./
EXPOSE 8087
ENTRYPOINT ["java", "-jar", "quarkus-run.jar"]
